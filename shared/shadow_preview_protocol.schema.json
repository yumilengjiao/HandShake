{
  "command": {
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 5,
        "title": "Version",
        "type": "integer"
      },
      "session_id": {
        "pattern": "^[a-f0-9]{32}$",
        "title": "Session Id",
        "type": "string"
      },
      "command_id": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Command Id",
        "type": "string"
      },
      "epoch": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Epoch",
        "type": "string"
      },
      "kind": {
        "enum": [
          "start_camera",
          "stop",
          "shutdown",
          "heartbeat",
          "surface_ack",
          "enable_shadow",
          "request_owner"
        ],
        "title": "Kind",
        "type": "string"
      },
      "model_epoch": {
        "anyOf": [
          {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model Epoch"
      },
      "model_sequence": {
        "anyOf": [
          {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model Sequence"
      },
      "model_revision": {
        "anyOf": [
          {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model Revision"
      },
      "track_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Track Id"
      }
    },
    "required": [
      "version",
      "session_id",
      "command_id",
      "epoch",
      "kind"
    ],
    "title": "ShadowCommand",
    "type": "object"
  },
  "snapshot": {
    "$defs": {
      "ClassificationNotice": {
        "additionalProperties": false,
