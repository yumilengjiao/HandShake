            "type": "string"
          },
          "model_version": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "temperature": {
            "maximum": 100,
            "minimum": 0.05,
