          "reason": {
            "enum": [
              "ready",
              "warming_up",
              "current_observation_invalid",
              "history_uninitialized",
              "stale",
              "insufficient_valid_ratio",
              "window_span_exceeded",
              "no_hand",
              "multiple_hands",
              "not_processed",
              "perception_error",
              "out_of_order",
              "future_input",
              "inference_error",
              "cancelled"
            ],
            "title": "Reason",
            "type": "string"
          },
          "model_version": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "model_type": {
            "enum": [
              "mlp",
              "tcn"
            ],
            "title": "Model Type",
            "type": "string"
          },
          "vocabulary_version": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Vocabulary Version",
            "type": "string"
          },
          "synthetic_training": {
            "title": "Synthetic Training",
            "type": "boolean"
          },
          "calibrated": {
            "const": false,
            "default": false,
            "title": "Calibrated",
            "type": "boolean"
