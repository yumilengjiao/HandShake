          "context_epoch": {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Context Epoch",
            "type": "string"
          },
          "source_frame_id": {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Source Frame Id",
            "type": "string"
          },
          "source_timestamp_ns": {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "title": "Source Timestamp Ns",
            "type": "string"
          },
          "track_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Track Id"
          },
          "window_length": {
            "maximum": 32,
            "minimum": 0,
            "title": "Window Length",
            "type": "integer"
          },
          "inference_ns": {
            "anyOf": [
              {
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inference Ns"
          },
          "logits": {
            "items": {
              "type": "number"
            },
            "maxItems": 15,
            "title": "Logits",
            "type": "array"
          }
        },
        "required": [
          "state",
          "reason",
          "model_version",
          "model_type",
          "vocabulary_version",
          "synthetic_training",
          "stream_id",
          "context_epoch",
          "source_frame_id",
          "source_timestamp_ns",
          "window_length",
          "logits"
        ],
        "title": "ClassificationNotice",
        "type": "object"
      },
      "PreviewHand": {
        "additionalProperties": false,
        "properties": {
          "landmarks": {
            "items": {
              "$ref": "#/$defs/PreviewPoint"
