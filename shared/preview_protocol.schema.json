{
  "command": {
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 2,
        "title": "Version",
        "type": "integer"
      },
      "session_id": {
        "pattern": "^[a-f0-9]{32}$",
        "title": "Session Id",
        "type": "string"
      },
      "command_id": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Command Id",
        "type": "string"
      },
      "epoch": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Epoch",
        "type": "string"
      },
      "kind": {
        "enum": [
          "start",
          "start_camera",
          "stop",
          "heartbeat",
          "shutdown"
        ],
        "title": "Kind",
        "type": "string"
      }
    },
    "required": [
      "version",
      "session_id",
      "command_id",
      "epoch",
      "kind"
    ],
    "title": "PreviewCommand",
    "type": "object"
  },
  "snapshot": {
    "$defs": {
      "PreviewHand": {
        "additionalProperties": false,
        "properties": {
          "landmarks": {
            "items": {
              "$ref": "#/$defs/PreviewPoint"
            },
            "maxItems": 21,
            "minItems": 21,
            "title": "Landmarks",
            "type": "array"
          },
          "validity": {
            "items": {
              "type": "boolean"
            },
            "maxItems": 21,
            "minItems": 21,
            "title": "Validity",
            "type": "array"
          },
          "usable": {
            "title": "Usable",
            "type": "boolean"
          }
        },
        "required": [
          "landmarks",
          "validity",
          "usable"
        ],
        "title": "PreviewHand",
        "type": "object"
      },
      "PreviewPoint": {
        "additionalProperties": false,
        "properties": {
          "x": {
            "maximum": 16,
            "minimum": -16,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 16,
            "minimum": -16,
            "title": "Y",
            "type": "number"
          },
          "z": {
            "maximum": 16,
            "minimum": -16,
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "PreviewPoint",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 2,
        "default": 2,
        "title": "Version",
        "type": "integer"
      },
      "session_id": {
        "pattern": "^[a-f0-9]{32}$",
        "title": "Session Id",
        "type": "string"
      },
      "sequence": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Sequence",
        "type": "string"
      },
      "epoch": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Epoch",
        "type": "string"
      },
      "last_command_id": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Last Command Id",
        "type": "string"
      },
      "timestamp_ns": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Timestamp Ns",
        "type": "string"
      },
      "state": {
        "enum": [
          "stopped",
          "starting",
          "preview",
          "stopping"
        ],
        "title": "State",
        "type": "string"
      },
      "reason": {
        "enum": [
          "initial",
          "synthetic_preview",
          "user_stop",
          "heartbeat_timeout",
          "stale_epoch",
          "protocol_error",
          "input_closed",
          "shutdown",
          "camera_starting",
          "camera_preview",
          "camera_unavailable",
          "perception_unavailable",
          "input_stalled",
          "preview_error"
        ],
        "title": "Reason",
        "type": "string"
      },
      "source": {
        "enum": [
          "synthetic",
          "camera"
        ],
        "title": "Source",
        "type": "string"
      },
      "mode": {
        "const": "dry_run",
        "default": "dry_run",
        "title": "Mode",
        "type": "string"
      },
      "model_status": {
        "const": "unavailable",
        "default": "unavailable",
        "title": "Model Status",
        "type": "string"
      },
      "control_available": {
        "const": false,
        "default": false,
        "title": "Control Available",
        "type": "boolean"
      },
      "frame_id": {
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "title": "Frame Id",
        "type": "string"
      },
      "frame_timestamp_ns": {
        "anyOf": [
          {
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Frame Timestamp Ns"
      },
      "frame_width": {
        "maximum": 640,
        "minimum": 0,
        "title": "Frame Width",
        "type": "integer"
      },
      "frame_height": {
        "maximum": 480,
        "minimum": 0,
        "title": "Frame Height",
        "type": "integer"
      },
      "timestamp_kind": {
        "enum": [
          "synthetic_generation",
          "software_read_complete_not_exposure"
        ],
        "title": "Timestamp Kind",
        "type": "string"
      },
      "capture_hz": {
        "anyOf": [
          {
            "maximum": 1000,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Capture Hz"
      },
      "perception_status": {
        "enum": [
          "unavailable",
          "processed_hands",
          "processed_no_hand",
          "not_processed",
          "error"
        ],
        "title": "Perception Status",
        "type": "string"
      },
      "hands": {
        "items": {
          "$ref": "#/$defs/PreviewHand"
        },
        "maxItems": 2,
        "title": "Hands",
        "type": "array"
      }
    },
    "required": [
      "session_id",
      "sequence",
      "epoch",
      "last_command_id",
      "timestamp_ns",
      "state",
      "reason",
      "source",
      "frame_id",
      "frame_timestamp_ns",
      "frame_width",
      "frame_height",
      "timestamp_kind",
      "perception_status",
      "hands"
    ],
    "title": "PreviewSnapshot",
    "type": "object"
  }
}
